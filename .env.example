# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public Web App URL (Optional - defaults to domain in browser or configured in Super Admin)
# Set this to your production web domain, e.g. https://wifi.yourisp.com or http://localhost:3000
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# MikroTik Router (Defaults, can also be configured dynamically in Super Admin dashboard)
MIKROTIK_IP=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASS=

# Flutterwave Payment Gateway (Can also be managed dynamically in Super Admin dashboard)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
